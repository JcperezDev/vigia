<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Puente</AssemblyName>
    <Version>2.0.1</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Product>Puente (instalador de Vigía)</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Vigia\vigia.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <!-- Solo para las pruebas automáticas (tools/puente-test.js): rutas y clave de prueba en %TEMP%. Nunca se publica. -->
  <PropertyGroup Condition="'$(PuenteTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PUENTE_TEST</DefineConstants>
    <AssemblyName>Puente-test</AssemblyName>
  </PropertyGroup>
  <!-- Servicio SYSTEM «Sensores de Vigía»: fuera de la versión pública hasta que pase una revisión externa
       (SENSOR_SERVICE_AUDIT.md). Solo las compilaciones de laboratorio lo activan con -p:SensorService=true. -->
  <PropertyGroup Condition="'$(SensorService)' == 'true'">
    <DefineConstants>$(DefineConstants);SENSOR_SERVICE</DefineConstants>
  </PropertyGroup>
</Project>
