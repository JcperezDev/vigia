<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Vigia</AssemblyName>
    <Version>0.20.17</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>vigia.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="vigia.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- dentro del .exe: un archivo suelto en la carpeta del usuario podría cambiarlo cualquier programa, y Vigía lo aplica como administrador -->
    <EmbeddedResource Include="tweaks.json" LogicalName="Vigia.tweaks.json" />
    <Content Include="drivers\PawnIO_setup.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\vigiaos.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
