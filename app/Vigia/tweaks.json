  },
  {
    "id": "mmcss-games",
    "group": "Rendimiento",
    "risk": "bajo",
    "reboot": true,
    "title": "Prioridad alta para juegos",
    "detail": "Sube la prioridad de la tarea «Games» del programador multimedia de Windows. Solo afecta a los juegos que se registran en ese servicio (pocos lo hacen); en los demás no cambia nada. Microsoft indica que «GPU Priority» aún no se usa.",
    "source": "https://learn.microsoft.com/en-us/windows/win32/procthread/multimedia-class-scheduler-service",
    "ops": [
      {
        "reg": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "name": "GPU Priority",
        "type": "dword",
        "value": 8
      },
      {
        "reg": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "name": "Priority",
        "type": "dword",
        "value": 6
      },
      {
        "reg": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "name": "Scheduling Category",
        "type": "string",
        "value": "High"
      },
      {
        "reg": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "name": "SFIO Priority",
        "type": "string",
        "value": "High"
      }
    ],
    "status": "experimental"
  },
